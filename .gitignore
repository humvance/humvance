# ── Secrets & credentials — NEVER commit ──
.env
.env.local
.env.*
.env*.local
*.env
*.pem
*.key
*.secret

# ── Vercel ──
.vercel/
.vercel

# ── Dependencies ──
node_modules/
.npm/

# ── Local databases ──
*.db
*.sqlite
*.sqlite3

# ── Backup folders ──
*_BACKUP_*/
*_backup_*/
claucode_BACKUP*/

# ── Temporary / test files ──
test-diagnostic-*.js
test-*.local.js

# ── OS files ──
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
*.log
npm-debug.log*

# ── Claude session reports (not part of the app) ──
Claude outputs/

# ── OneDrive device-conflict artifacts ──
# OneDrive renames a file to <name>-<DEVICE>.<ext> when two computers write it.
# The 2026-09-17 incident produced 27 of these; all were verified to contain no
# unique work (docs/ENGINEERING-STATE.md §0). Ignored so that `git add -A` can
# never commit a stale copy on top of good work.
*-MOHAMMED*
-MOHAMMED*
